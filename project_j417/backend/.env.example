# --- MongoDB (use the same values as your base project) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=research_project

# --- Output ---
DATA_DIR=data

# --- ASR (leave "auto" for best defaults) ---
# auto -> GPU: large-v3-turbo / float16 / batch 16   |   CPU: small / int8 / batch 8
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
BATCH_SIZE=0
BEAM_SIZE=5

# --- Segment selection (ranking) ---
# Small ONNX embedding model. English: BAAI/bge-small-en-v1.5 (33 MB).
# Multilingual (e.g. Sinhala/Tamil): intfloat/multilingual-e5-large is heavy; use
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2. "none" = keyword (BM25) only.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Limits ---
MAX_DURATION_SEC=14400
MAX_CONCURRENT_JOBS=1
PRELOAD_MODEL=true
KEEP_AUDIO=false

# Optional: cookies.txt (Netscape format) if YouTube asks to sign in / blocks downloads
# YTDLP_COOKIES_FILE=cookies.txt

CORS_ORIGINS=http://localhost:5173
