# --- MongoDB (use the same values as your base project) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=research_project

# --- Output ---
DATA_DIR=data

# --- ASR (leave "auto" for best defaults) ---
# auto -> GPU: large-v3-turbo / float16 / batch 16 / beam 5
#         CPU: distil-small.en (English only) / int8 / batch 8 / beam 1
# Other languages on CPU: WHISPER_MODEL=small
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
BATCH_SIZE=0
BEAM_SIZE=0

# --- Limits ---
MAX_DURATION_SEC=14400
MAX_CONCURRENT_JOBS=1
PRELOAD_MODEL=true
KEEP_AUDIO=false

# Optional: cookies.txt (Netscape format) if YouTube asks to sign in / blocks downloads
# YTDLP_COOKIES_FILE=cookies.txt

CORS_ORIGINS=http://localhost:5173
